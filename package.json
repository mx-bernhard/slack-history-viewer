{
  "name": "slack-history-viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:ssr",
    "dev:ssr": "nodemon --watch server.tsx --watch src/server --ext ts,tsx --exec \"node --experimental-strip-types scripts/run-with-vite.ts server.tsx\"",
    "build:client": "vite build --outDir dist/client",
    "build:server-render": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:server-logic": "tsc --project tsconfig.node.json",
    "build": "yarn build:client && yarn build:server-render && yarn build:server-logic",
    "start": "NODE_ENV=production node dist/server/server.js",
    "lint": "run-p -c -n \"lint:**\"",
    "lint:prettier": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:eslint": "eslint",
    "lint:tsc": "tsc -b tsconfig.json",
    "prettify": "prettier --write \"src/**/*.{ts,tsx}\" && eslint . --fix",
    "preview": "vite preview",
    "generate-emoji-map": "node --experimental-strip-types scripts/generate-emoji-map.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.2.6",
    "@mui/icons-material": "7.3.2",
    "@mui/material": "7.3.1",
    "@mui/x-tree-view": "8.10.2",
    "@tanstack/react-query": "^5.71.5",
    "@tanstack/react-router": "1.131.40",
    "@tanstack/react-router-devtools": "1.131.40",
    "@tanstack/zod-adapter": "1.131.40",
    "@uidotdev/usehooks": "2.4.1",
    "classnames": "2.5.1",
    "compression": "1.8.2",
    "debounce-collect": "^1.0.2",
    "dotenv": "16.5.0",
    "emoji-datasource-google": "15.1.2",
    "express": "5.1.0",
    "lodash-es": "^4.18.1",
    "micro-memoize": "4.1.3",
    "p-limit": "6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "4.14.0",
    "remark-gfm": "^4.0.1",
    "typed-assert": "1.0.9",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@slack/web-api": "7.9.3",
    "@tanstack/router-plugin": "1.131.40",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/lodash-es": "4.17.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "^16.0.0",
    "jiti": "2.5.1",
    "nodemon": "^3.1.9",
    "npm-run-all2": "8.0.4",
    "prettier": "^3.5.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "packageManager": "yarn@4.9.2",
  "resolutions": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "qs": "^6.16.1",
    "seroval": "^1.6.11",
    "seroval-plugins": "^1.6.11",
    "shell-quote": "^1.11.0",
    "axios": "^1.20.0",
    "follow-redirects": "^1.16.2",
    "js-yaml": "^4.3.2",
    "source-map-js": "^1.2.2",
    "minimatch@npm:^10.2.1": "^11.0.5",
    "minimatch@npm:^10.2.2": "^11.0.5",
    "brace-expansion@npm:^1.1.7": "^1.1.21",
    "brace-expansion@npm:^5.0.8": "^5.0.12",
    "undici@npm:^8.4.1": "^8.12.2",
    "vite": "^8.3.6"
  }
}
